# ==========================================
# Konfigurasi Lingkungan Proyek Capstone (Template)
# Duplikat file ini menjadi .env lalu isi nilainya
# ==========================================
APP_ENV=development
APP_NAME="Automated Candidate Screening & Rating System"

# ==========================================
# Konfigurasi Ekstraksi Teks (PyMuPDF + EasyOCR)
# ==========================================
MIN_CHAR_THRESHOLD=80
OCR_LANGUAGES=en,id
USE_GPU=True
OCR_DPI=150
EASYOCR_MODEL_DIR=.easyocr_models
DATA_DIR=data/sample_cvs

# ==========================================
# Konfigurasi Model LLM (Tahap Screening & Rating)
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

